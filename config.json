{
    "enabled": false,
    "interval": 3600,
    "base_path": "/sdcard/Sortify",
    "download_path": "/sdcard/Download",
    "recursive": true,
    "max_depth": 5,
    "enabled_categories": {
        "documents": true,
        "images": true,
        "videos": true,
        "audio": true,
        "archives": true,
        "apps": true,
        "magisk": true,
        "others": true
    },
    "exclude_folders": ["WhatsApp", "Music", "Screenshots"]
}
